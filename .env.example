# Copiar a `.env.local` y completar. Sin estas variables la app corre en MODO DEMO
# (auth simulada en el navegador + datos JSON de /public/data).

# --- Frontend (expuestas al navegador, prefijo VITE_) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend (solo serverless /api, NUNCA con prefijo VITE_) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
SUPABASE_SERVICE_ROLE_KEY=
